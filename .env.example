# Copy this file to .env and fill in your API keys

# Optional: NewsAPI (https://newsapi.org) for enhanced news fetching
NEWS_API_KEY=your_newsapi_key_here

# Optional: Twitter/X Bearer Token for social sentiment
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Optional: EIA API Key for commodity supply/demand data (free at eia.gov)
QUANDL_API_KEY=your_eia_key_here

# Optional: Alpha Vantage for additional market data
ALPHA_VANTAGE_KEY=your_av_key_here

# API server
PREDICTION_API_KEY=change-this-secret-key
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Redis (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
